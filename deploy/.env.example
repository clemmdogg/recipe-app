# Copy this file to .env on the server and fill it in. .env is never committed.
# Make the secrets with:  openssl rand -hex 32  (hex, because the password goes into a URL)

# The addresses. Both must point at the server's IP address in DNS (A records).
WEB_DOMAIN=recipes.clemdev.dk
API_DOMAIN=api.recipes.clemdev.dk

# The database password. Only the API uses it, inside Docker.
POSTGRES_PASSWORD=CHANGE_ME

# Signs access tokens. A long random string, different from the one on your computer.
JWT_SECRET=CHANGE_ME
