# Copy this file to .env.local (never committed) and fill in the address of the API.
# Restart `npm start` after changing it.

# While developing: your computer's Wi-Fi IP address, so the phone can reach the API on it.
# Find it with `ipconfig` (Windows). The API must run with HOST=0.0.0.0 in api/.env.
# On the server later: https://api.<your-domain>
EXPO_PUBLIC_API_URL=http://192.168.0.149:3000
