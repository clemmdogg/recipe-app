# Copy this file to .env and fill in the passwords. .env is never committed.

# The API's own database user (not the "postgres" admin user).
DATABASE_URL=postgres://recipe_app:CHANGE_ME@localhost:5432/recipe_app

# Used only by `npm test`. The tests delete everything in this database.
TEST_DATABASE_URL=postgres://recipe_app:CHANGE_ME@localhost:5432/recipe_app_test

# 127.0.0.1 only accepts connections from this computer. Docker on the server uses 0.0.0.0.
HOST=127.0.0.1
PORT=3000

# Signs access tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Set to true on the server, where requests come through Caddy. Rate limiting then sees
# each phone's real IP address instead of Caddy's.
TRUST_PROXY=false

# Invite links are <this>/<code>. On the server: https://<your-domain>/join
INVITE_LINK_BASE_URL=http://localhost:3000/join
